project_name     = "finguard"
environment      = "dev"
aws_region       = "us-east-1"
vpc_cidr         = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnets   = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnets  = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]
db_username      = "finguard"
db_password      = "changeme" # Cambiar en producción
container_image  = "public.ecr.aws/aws/amazon-linux:latest" # Reemplazar por tu imagen ECR
desired_count    = 1 # Free Tier / mínimo costo en dev
sagemaker_s3_bucket = "finguard-sagemaker-artifacts"

# Free Tier / mínimo costo:
# - Aurora: db.t3.micro en dev, db.t3.medium en prod
# - SageMaker: solo se crea en prod
# - ECS: 1 tarea en dev, 2 en prod
# - DynamoDB: PAY_PER_REQUEST (sin costo si no se usa)
