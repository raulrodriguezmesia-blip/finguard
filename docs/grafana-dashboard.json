{
  "dashboard": {
    "title": "FinGuard - Fraud Detection Observability",
    "tags": ["finguard", "fraud", "mlops"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Latency (p50, p95, p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(finguard_fraud_evaluation_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(finguard_fraud_evaluation_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(finguard_fraud_evaluation_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "yAxes": [
          {
            "label": "seconds",
            "format": "s"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 2,
        "title": "Fraud Rate by Merchant (last 5m)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(finguard_fraud_by_merchant_total[5m])) by (merchantId)",
            "legendFormat": "{{merchantId}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "fraud count",
            "format": "short"
          }
        ],
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 3,
        "title": "Model Drift Factor",
        "type": "gauge",
        "targets": [
          {
            "expr": "finguard_model_drift",
            "refId": "A"
          }
        ],
        "options": {
          "min": 1.0,
          "max": 2.0,
          "thresholds": {
            "steps": [
              {
                "value": 1.0,
                "color": "green"
              },
              {
                "value": 1.3,
                "color": "yellow"
              },
              {
                "value": 1.6,
                "color": "red"
              }
            ]
          }
        },
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 8,
          "h": 6
        }
      },
      {
        "id": 4,
        "title": "Total Evaluations vs Fraud Detected",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(finguard_evaluations_total_count[5m]))",
            "legendFormat": "evaluations",
            "refId": "A"
          },
          {
            "expr": "sum(rate(finguard_fraud_detected_count[5m]))",
            "legendFormat": "fraud",
            "refId": "B"
          }
        ],
        "yAxes": [
          {
            "label": "count",
            "format": "short"
          }
        ],
        "gridPos": {
          "x": 8,
          "y": 8,
          "w": 12,
          "h": 6
        }
      },
      {
        "id": 5,
        "title": "Evaluation Errors",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(finguard_evaluation_errors_total[5m]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto"
        },
        "gridPos": {
          "x": 20,
          "y": 8,
          "w": 4,
          "h": 6
        }
      }
    ]
  }
}